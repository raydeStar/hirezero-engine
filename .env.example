# Set these in your shell; the engine reads only environment variables. Real keys never go in this file.

# Every model call goes to Vultr Serverless Inference by default.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Optional overrides (defaults shown).
# HIREZERO_INFERENCE_MODEL=deepseek-v4.1-flash-1017
# HIREZERO_INFERENCE_MAX_OUTPUT_TOKENS=24000
# HIREZERO_INFERENCE_TIMEOUT_SECONDS=300
# HIREZERO_INFERENCE_REASONING_EFFORT=low   # minimal | low | medium | high; Vultr cannot turn reasoning off

# Local tests only, before a Vultr key exists: route the same calls through OpenRouter.
# HIREZERO_INFERENCE_PROVIDER=openrouter
# OPENROUTER_API_KEY=
