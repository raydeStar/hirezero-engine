# Replace the reserved name and certificate paths before running nginx -t.
# TLS terminates here; both ASP.NET processes bind to loopback only.
server {
    listen 443 ssl;
    server_name evidence.example.invalid;
    ssl_certificate     /etc/hirezero-tls/fullchain.pem;
    ssl_certificate_key /etc/hirezero-tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;

    # The gallery process has no worker credentials, private data directory or Docker group.
    location ~ ^/api/gallery(?:/|$) {
        limit_except GET { deny all; }
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-HireZero-CSRF "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:5078;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        # Drafting and answering may both involve long-running model requests.
        proxy_read_timeout 600s;
        proxy_next_upstream off;
        proxy_pass http://127.0.0.1:5077;
    }
}
