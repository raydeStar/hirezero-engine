<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Every *.Tests project is an xUnit v3 test executable on Microsoft.Testing.Platform (see global.json);
       helper executables such as FakeCodex are not. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Verify.cs" Link="Shared/Verify.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
